# kinora self-host config (used by docker-compose.yml). Copy to .env and edit.

# Public URL where users reach kinora (this web container). Drives links, cookies, and artifact URLs.
# If you put kinora behind your own HTTPS proxy, set this to that public https URL.
PUBLIC_URL=http://localhost:8080
# Host port the web container binds to (match PUBLIC_URL).
WEB_PORT=8080
# Image tag to run: latest (every main commit) or a pinned sha-<commit> from the GHCR packages.
KINORA_IMAGE_TAG=latest

# Session secret. Generate one: openssl rand -hex 32
AUTH_SECRET=change-me-with-a-long-random-string

# Postgres (POSTGRES_HOST is set to the compose service automatically).
POSTGRES_USER=kinora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kinora
POSTGRES_PORT=5432

# Self-host: keep cloud billing off, and the cookie host-only (single origin).
KINORA_CLOUD=false
COOKIE_DOMAIN=

# Social login (optional). Leave empty to use email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic OIDC SSO (Okta, Keycloak, Entra ID, Authentik, Auth0, ...). Leave OIDC_ISSUER_URL empty
# to disable. Redirect URL to register with the IdP: ${PUBLIC_URL}/api/auth/oauth2/callback/oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label: "Continue with <name>".
OIDC_PROVIDER_NAME=SSO
# The callback needs email and sub. A name claim is optional - kinora derives one from
# preferred_username, given_name, or the email local part. These scopes are a good default.
OIDC_SCOPES=openid profile email
# Only if the discovery document isn't at <issuer>/.well-known/openid-configuration.
OIDC_DISCOVERY_URL=
OIDC_PKCE=true

# SSO-only: turn off email + password sign-in and sign-up. Requires OIDC_* or a social provider
# above (the server refuses to boot otherwise, so a typo can't lock everyone out).
KINORA_DISABLE_PASSWORD_AUTH=false

# Email (optional): enables verification, password reset, invitations, and alert emails.
# Any SMTP provider works (Resend, Brevo, SES, self-hosted). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="kinora <no-reply@example.dev>"

# Retention (optional). 0 = keep everything, the default. Non-zero starts a daily sweep.
# Deletes stored trace.zip files older than N days (screenshots and videos ride inside them)
# while keeping the runs, so pass rates, trends and flaky history survive. Start here.
KINORA_ARTIFACT_RETENTION_DAYS=0
# These delete whole runs, history included. KINORA_KEEP_LAST_RUNS counts per project.
KINORA_RETENTION_DAYS=0
KINORA_KEEP_LAST_RUNS=0

# Artifact storage: leave S3_* empty to store trace.zip on a local volume (default).
# Set endpoint + region + bucket together to use any S3-compatible store instead; the two
# credentials are optional (set both, or neither to use the AWS default credential chain).
# The bucket needs CORS for GET + Range from PUBLIC_URL - see docs.kinora.dev/self-hosting/storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true (default) = path-style URLs; false = virtual-hosted (bucket.host/key), AWS's preference.
S3_FORCE_PATH_STYLE=true
